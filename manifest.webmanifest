{
  "name": "MolarDash",
  "short_name": "MolarDash",
  "description": "Sistema para consultorios odontológicos",
  "start_url": "/app/",
  "scope": "/",
  "display": "browser",
  "background_color": "#ffffff",
  "theme_color": "#0f1b2d",
  "lang": "es",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
